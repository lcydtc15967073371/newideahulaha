package com.virtuallocation.app

import android.content.Context
import android.location.Location
import android.location.LocationManager
import android.os.Build
import android.os.SystemClock
import android.util.Log
import kotlinx.coroutines.*

class MockLocationHelper(private val context: Context) {

    companion object {
        private const val TAG = "MockLocationHelper"
        private const val UPDATE_INTERVAL_MS = 100L
        private val PROVIDERS = arrayOf("gps", "network", "passive")
    }

    private val locationManager = context.getSystemService(Context.LOCATION_SERVICE) as LocationManager
    private var mockJob: Job? = null
    private var currentLat = 0.0
    private var currentLng = 0.0

    fun startMock(latitude: Double, longitude: Double): String? {
        stopMock()
        currentLat = latitude
        currentLng = longitude

        try {
            // 为多个 Provider 注册模拟
            for (provider in PROVIDERS) {
                try {
                    locationManager.removeTestProvider(provider)
                } catch (_: Exception) { }
                try {
                    locationManager.addTestProvider(
                        provider, false, false, false, false, true, true, true,
                        android.location.Criteria.POWER_LOW,
                        android.location.Criteria.ACCURACY_FINE
                    )
                    locationManager.setTestProviderEnabled(provider, true)
                } catch (e: Exception) {
                    Log.w(TAG, "注册 $provider 失败: ${e.message}")
                }
            }

            // 持续推送
            mockJob = CoroutineScope(Dispatchers.IO).launch {
                var seq = 0L
                while (isActive) {
                    val time = System.currentTimeMillis()
                    val elapsed = SystemClock.elapsedRealtimeNanos()

                    for (provider in PROVIDERS) {
                        try {
                            val loc = Location(provider)
                            loc.latitude = currentLat
                            loc.longitude = currentLng
                            loc.accuracy = 3.0f
                            loc.time = time
                            loc.elapsedRealtimeNanos = elapsed
                            loc.altitude = 0.0
                            loc.speed = 0.0f
                            loc.bearing = 0.0f

                            locationManager.setTestProviderLocation(provider, loc)
                        } catch (_: Exception) { }
                    }

                    seq++
                    if (seq % 200 == 0L) {
                        Log.d(TAG, "已推送 $seq 次")
                    }
                    delay(UPDATE_INTERVAL_MS)
                }
            }

            Log.d(TAG, "模拟定位已启动: $latitude, $longitude")
            return null

        } catch (e: SecurityException) {
            Log.e(TAG, "安全异常: ${e.message}")
            return "权限不足，请检查定位权限和模拟定位授权"
        } catch (e: IllegalArgumentException) {
            Log.e(TAG, "参数异常: ${e.message}")
            return "提供者注册失败"
        } catch (e: Exception) {
            Log.e(TAG, "未知异常: ${e.message}")
            return "启动失败: ${e.localizedMessage}"
        }
    }

    fun stopMock() {
        mockJob?.cancel()
        mockJob = null
        for (provider in PROVIDERS) {
            try {
                locationManager.setTestProviderEnabled(provider, false)
                locationManager.removeTestProvider(provider)
            } catch (_: Exception) { }
        }
        Log.d(TAG, "模拟定位已停止")
    }

    fun isMocking(): Boolean = mockJob?.isActive == true
}


